flowchart TD
    classDef ghBg fill:#ffffff,stroke:#d0d7de,stroke-width:2px,color:#24292f
    classDef ghHead fill:#f6f8fa,stroke:#d0d7de,stroke-width:2px,color:#0969da,font-weight:bold
    classDef ghProc fill:#f6f8fa,stroke:#d0d7de,stroke-width:1px,color:#24292f
    classDef ghDec fill:#fff8c5,stroke:#d4a72c,stroke-width:2px,color:#24292f
    classDef ghErr fill:#ffebe9,stroke:#d1242f,stroke-width:2px,color:#d1242f
    classDef ghOk fill:#dafbe1,stroke:#1a7f37,stroke-width:2px,color:#1a7f37
    classDef ghBreak fill:#f6f8fa,stroke:#656d76,stroke-width:2px,color:#656d76

    S(["delegatedTask(M, N)"]):::ghHead
    S --> For["<b>for (i = 1; i &lt;= M; i++)</b>"]:::ghProc
    For --> Agent["const r = await agent(goal,<br/><span style='font-size:10px'>{ budget: { maxSteps: N } }</span>)"]:::ghProc

    Agent --> Err{"r.error ?"}:::ghDec
    Err -->|yes| V1["const v = await reason(goal,<br/><span style='font-size:10px'>observation: error</span>)"]:::ghErr
    V1 --> R1{"v.action ===<br/>'retry' ?"}:::ghDec
    R1 -->|yes| For
    R1 -->|no| Esc1["return { status:'escalate',<br/><span style='font-size:10px'>reason: v.reason }</span>"]:::ghBreak

    Err -->|no| Traj["const traj = extractTrajectory(r)"]:::ghProc
    Traj --> V2["const v = await reason(goal,<br/><span style='font-size:10px'>observation: text + traj</span>)"]:::ghOk
    V2 --> R2{"v.action ?"}:::ghDec

    R2 -->|done| Done["return v.data"]:::ghOk
    R2 -->|continue| For
    R2 -->|else| Esc2["return { status:'escalate',<br/><span style='font-size:10px'>reason: v.reason }</span>"]:::ghBreak

    Done --> E(["end"])
    Esc1 --> E
    Esc2 --> E